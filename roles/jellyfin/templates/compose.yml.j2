# {{ ansible_managed }}
services:
  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    restart: unless-stopped
    user: "{{ jellyfin_uid }}:{{ jellyfin_uid }}"
{% if jellyfin_gpu_vendor == 'nvidia' %}
    runtime: nvidia
{% elif jellyfin_gpu_vendor %}
    group_add:
      - "{{ gpu_render_gid }}"
    devices:
{# A single pinned node is exposed as renderD128, Jellyfin's default VA-API device. #}
      - {{ jellyfin_gpu_device }}:{{ '/dev/dri' if jellyfin_gpu_device == '/dev/dri' else '/dev/dri/renderD128' }}
{% endif %}
    environment:
      TZ: {{ base_timezone }}
{% if jellyfin_gpu_vendor == 'nvidia' %}
      NVIDIA_VISIBLE_DEVICES: {{ jellyfin_nvidia_devices }}
      NVIDIA_DRIVER_CAPABILITIES: all
{% endif %}
{% if jellyfin_published_url %}
      JELLYFIN_PublishedServerUrl: {{ jellyfin_published_url }}
{% endif %}
    ports:
      - "8096:8096"        # HTTP
      - "7359:7359/udp"    # client auto-discovery
      - "1900:1900/udp"    # DLNA
    volumes:
      - {{ jellyfin_dir }}/config:/config
      - {{ jellyfin_dir }}/cache:/cache
      - {{ jellyfin_media_path }}:/media:ro
