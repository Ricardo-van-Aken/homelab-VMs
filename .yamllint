---
extends: default
rules:
  line-length:
    max: 120
  truthy:
    # GitHub Actions uses `on:` as a top-level key.
    check-keys: false
  comments:
    min-spaces-from-content: 1
  # Required for compatibility with ansible-lint's yaml rule.
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
ignore:
  - collections/
  - galaxy_roles/
  - .ansible/
