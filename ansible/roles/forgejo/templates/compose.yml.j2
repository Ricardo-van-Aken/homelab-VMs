# {{ ansible_managed }}
services:
  forgejo:
    image: {{ forgejo_image }}
    container_name: forgejo
    restart: unless-stopped
    environment:
      USER_UID: "{{ forgejo_uid }}"
      USER_GID: "{{ forgejo_uid }}"
      TZ: {{ base_timezone }}
      FORGEJO__database__DB_TYPE: sqlite3
      FORGEJO__server__DOMAIN: {{ forgejo_domain }}
      FORGEJO__server__ROOT_URL: {{ forgejo_root_url }}
      FORGEJO__server__SSH_DOMAIN: {{ forgejo_domain }}
      FORGEJO__server__SSH_PORT: "{{ forgejo_ssh_port }}"
      FORGEJO__security__INSTALL_LOCK: "true"
      FORGEJO__service__DISABLE_REGISTRATION: "true"
{% for key, value in forgejo_extra_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    ports:
      - "{{ forgejo_http_port }}:3000"
      - "{{ forgejo_ssh_port }}:22"
    volumes:
      - {{ forgejo_data_dir }}:/data
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:3000/api/healthz"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 30s
