# {{ ansible_managed }}
services:
  mealie:
    image: {{ mealie_image }}
    container_name: mealie
    restart: unless-stopped
    environment:
      PUID: "{{ mealie_uid }}"
      PGID: "{{ mealie_uid }}"
      TZ: {{ base_timezone }}
      BASE_URL: {{ mealie_url }}
      ALLOW_SIGNUP: "false"
{% if mealie_shared_user %}
      # Trust the username Caddy puts in X-Forwarded-User when the secret
      # from proxy.env comes with it.
      REVERSE_PROXY_AUTH_ENABLED: "true"
{% endif %}
{% for key, value in mealie_extra_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% if mealie_shared_user %}
    env_file:
      - proxy.env
{% endif %}
    ports:
      - "127.0.0.1:{{ mealie_http_port }}:9000"  # Caddy forwards to it
    volumes:
      - {{ mealie_data_dir }}:/app/data
    deploy:
      resources:
        limits:
          memory: {{ mealie_memory_limit }}
