# {{ ansible_managed }}
# The dashboards refer to the stores by these uids.
apiVersion: 1
datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://loki:3100
    editable: false
    # Every machine's store of logs, read together.
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: "{{ grafana_machines | selectattr('agent', 'equalto', 'alloy') | map(attribute='name') | join('|') }}"
