# {{ ansible_managed }}
{{ caddy_scheme }}{{ grafana_domain }} {
	import dns_challenge
	reverse_proxy 127.0.0.1:{{ grafana_http_port }}
}

# Where the agents send their logs. Only the request that writes logs is
# passed on, and only with a machine's token; the logs are then filed under
# that machine's name, whatever the request itself says. Everything else,
# reading included, is refused.
http://:{{ grafana_logs_port }} {
{% for machine in grafana_machines %}
	@{{ machine.name }} {
		method POST
		path /loki/api/v1/push
		header Authorization "Bearer {{ grafana_tokens[machine.name] }}"
	}
	handle @{{ machine.name }} {
		request_body {
			max_size {{ grafana_logs_request }}
		}
		reverse_proxy 127.0.0.1:{{ grafana_loki_port }} {
			header_up X-Scope-OrgID {{ machine.name }}
		}
	}
{% endfor %}
	handle {
		respond 403
	}
}
