        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mc_player_list{instance=\"$server\"} > 0",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "id": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "name": "Player"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
