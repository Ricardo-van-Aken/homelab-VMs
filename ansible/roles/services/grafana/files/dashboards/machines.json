{
  "uid": "machines",
  "title": "Machines",
  "tags": [
    "homelab",
    "provisioned"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "A"
        },
        "definition": "label_values(node_uname_info, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "hypervisor",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_rss{vm!=\"\"}, instance)",
          "refId": "A"
        },
        "definition": "label_values(container_memory_rss{vm!=\"\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "hide": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Search logs",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 21,
      "type": "barchart",
      "repeat": "hypervisor",
      "repeatDirection": "v",
      "title": "Memory of $hypervisor, by who it is reserved for",
      "description": "Each VM is the memory it was given, used inside the VM or not. ZFS cache is what the host keeps of files it read. The host itself is everything else in use on the host. Not reserved is what is left. A VM without an agent is not shown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm) (label_replace(node_memory_MemTotal_bytes, \"vm\", \"$1\", \"instance\", \"(.+)\") and on (vm) container_memory_working_set_bytes{instance=\"$hypervisor\",vm!=\"\"})",
          "legendFormat": "{{vm}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "clamp_min(sum(node_memory_MemTotal_bytes{instance=\"$hypervisor\"} - node_memory_MemAvailable_bytes{instance=\"$hypervisor\"}) - sum(container_memory_working_set_bytes{instance=\"$hypervisor\",vm!=\"\"}) - sum(node_zfs_arc_size{instance=\"$hypervisor\"} or vector(0)), 0)",
          "legendFormat": "the host itself",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "sum(node_zfs_arc_size{instance=\"$hypervisor\"})",
          "legendFormat": "ZFS cache",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "clamp_min(sum(node_memory_MemAvailable_bytes{instance=\"$hypervisor\"}) - sum(label_replace(node_memory_MemTotal_bytes, \"vm\", \"$1\", \"instance\", \"(.+)\") and on (vm) container_memory_working_set_bytes{instance=\"$hypervisor\",vm!=\"\"}) + sum(container_memory_working_set_bytes{instance=\"$hypervisor\",vm!=\"\"}), 0)",
          "legendFormat": "not reserved",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "the host itself"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b877d9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "not reserved"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5a5a5a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ZFS cache"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8a6fb0"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "Time",
        "showValue": "never",
        "barWidth": 0.9,
        "xTickLabelMaxLength": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "type": "barchart",
      "repeat": "hypervisor",
      "repeatDirection": "v",
      "title": "CPU of $hypervisor, by who uses it",
      "description": "The whole bar is all of the host's cores, over the last five minutes. Each VM is what its virtual machine uses on the host. The host itself is everything else that was busy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm) (rate(container_cpu_usage_seconds_total{instance=\"$hypervisor\",vm!=\"\"}[5m])) / scalar(count(count by (cpu) (node_cpu_seconds_total{instance=\"$hypervisor\"})))",
          "legendFormat": "{{vm}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "clamp_min(1 - avg(rate(node_cpu_seconds_total{instance=\"$hypervisor\",mode=\"idle\"}[5m])) - sum(rate(container_cpu_usage_seconds_total{instance=\"$hypervisor\",vm!=\"\"}[5m])) / scalar(count(count by (cpu) (node_cpu_seconds_total{instance=\"$hypervisor\"}))), 0)",
          "legendFormat": "the host itself",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "avg(rate(node_cpu_seconds_total{instance=\"$hypervisor\",mode=\"idle\"}[5m]))",
          "legendFormat": "idle",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "the host itself"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b877d9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "idle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5a5a5a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "Time",
        "showValue": "never",
        "barWidth": 0.9,
        "xTickLabelMaxLength": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Memory in use",
      "description": "Memory that programs hold and cannot be freed: total minus available. File cache is not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes{instance!~\"$hypervisor\"} / node_memory_MemTotal_bytes{instance!~\"$hypervisor\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "CPU in use",
      "description": "Share of all cores that was busy over the last five minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{instance!~\"$hypervisor\",mode=\"idle\"}[5m]))",
          "legendFormat": "{{instance}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "## $host: CPU and memory"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU by kind",
      "description": "Share of all cores, by what the time went to.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{instance=\"$host\",mode!=\"idle\"}[$__rate_interval])) / scalar(count(count by (cpu) (node_cpu_seconds_total{instance=\"$host\"})))",
          "legendFormat": "{{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "sortBy": "Last *",
          "sortDesc": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory",
      "description": "In use is what programs hold. File cache is memory Linux fills with files it has read and gives back when programs need it, so in use plus cache normally adds up to the total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{instance=\"$host\"} - node_memory_MemAvailable_bytes{instance=\"$host\"}",
          "legendFormat": "in use",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "node_memory_Cached_bytes{instance=\"$host\"} + node_memory_Buffers_bytes{instance=\"$host\"} + node_memory_SReclaimable_bytes{instance=\"$host\"}",
          "legendFormat": "file cache",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "node_memory_MemFree_bytes{instance=\"$host\"}",
          "legendFormat": "free",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "node_memory_SwapTotal_bytes{instance=\"$host\"} - node_memory_SwapFree_bytes{instance=\"$host\"}",
          "legendFormat": "swap in use",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "## $host: is the file cache large enough?"
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "File cache now",
      "description": "Memory Linux has filled with files it read, to answer the next read without the disk. It gives this back when programs need memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_Cached_bytes{instance=\"$host\"} + node_memory_Buffers_bytes{instance=\"$host\"} + node_memory_SReclaimable_bytes{instance=\"$host\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Read from disk again",
      "description": "Pages per second that were dropped from the cache and then needed again, as the average over the period shown. Linux keeps no hit rate for its file cache; this is the miss that counts. Green: under 10. Red: over 100, the cache is too small.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 33,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_vmstat_workingset_refault_file{instance=\"$host\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: pages/s",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Time lost waiting for memory",
      "description": "Share of time in which at least one program stood still because memory was short, as the average over the period shown. Green: under 1%. Red: over 5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_pressure_memory_waiting_seconds_total{instance=\"$host\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Swapping",
      "description": "Pages per second moved to and from swap, as the average over the period shown. Anything steady above zero means the machine is short of memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 33,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_vmstat_pswpout{instance=\"$host\"}[$__rate_interval]) + rate(node_vmstat_pswpin{instance=\"$host\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: pages/s",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 11,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "## $host: ZFS cache (machines with a pool)"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "ZFS cache hit rate",
      "description": "Share of reads answered from the ZFS cache (ARC) without touching the disks.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
