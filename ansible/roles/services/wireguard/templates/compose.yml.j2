# {{ ansible_managed }}
services:
  wg-easy:
    image: {{ wireguard_image }}
    container_name: wg-easy
    restart: unless-stopped
    environment:
      PORT: "{{ wireguard_web_port }}"
      INSECURE: "{{ wireguard_insecure | bool | lower }}"
      TRUSTED_PROXIES: {{ wireguard_trusted_proxies }}
    networks:
      wg:
        ipv4_address: {{ wireguard_docker_address }}
        ipv6_address: {{ wireguard_docker_address6 }}
    volumes:
      - {{ wireguard_data_dir }}:/etc/wireguard
      - /lib/modules:/lib/modules:ro
    ports:
      - "{{ wireguard_port }}:51820/udp"
      - "127.0.0.1:{{ wireguard_web_port }}:{{ wireguard_web_port }}/tcp"
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
      - net.ipv6.conf.all.disable_ipv6=0
      - net.ipv6.conf.all.forwarding=1
      - net.ipv6.conf.default.forwarding=1

networks:
  wg:
    driver: bridge
    enable_ipv6: true
    ipam:
      driver: default
      config:
        - subnet: {{ wireguard_docker_subnet }}
        - subnet: {{ wireguard_docker_subnet6 }}
