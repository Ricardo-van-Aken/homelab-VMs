# {{ ansible_managed }}
[Interface]
Address = {{ egress_vpn_address }}
# The tunnel's default route goes into its own table, which only the
# isolated network's traffic uses; this machine keeps its LAN route.
Table = {{ egress_vpn_table }}
# The private key stays in its own file, out of this one.
PostUp = wg set %i private-key {{ egress_vpn_key_file }}
# Only what arrives from the isolated network: this machine's own traffic
# to it, SSH to the VM among it, stays off the tunnel.
PostUp = ip rule add from {{ egress_isolated.network }} iif {{ egress_isolated_interface }} lookup {{ egress_vpn_table }} priority 100
# Players arrive through the tunnel from addresses this machine would
# itself reach over the LAN; do not drop them for that.
PostUp = sysctl -q -w net.ipv4.conf.%i.rp_filter=2
PostDown = ip rule del priority 100

[Peer]
PublicKey = {{ egress_vpn_peer_public_key }}
Endpoint = {{ egress_vpn_endpoint }}
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
