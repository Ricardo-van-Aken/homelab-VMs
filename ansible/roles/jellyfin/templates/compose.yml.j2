# {{ ansible_managed }}
services:
  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    restart: unless-stopped
    user: "{{ jellyfin_uid }}:{{ jellyfin_uid }}"
{% if jellyfin_gpu_vendor == 'nvidia' %}
    runtime: nvidia
{% elif jellyfin_gpu_vendor %}
    group_add:
      - "{{ gpu_render_gid }}"
{# Long form: by-path names contain colons, which the short host:container
   form would misread as separators. A pinned node is exposed as renderD128,
   Jellyfin's default VA-API device. #}
    devices:
{% if jellyfin_gpu_device %}
      - source: {{ jellyfin_gpu_device }}
        target: /dev/dri/renderD128
        permissions: rwm
{% else %}
      - source: /dev/dri
        target: /dev/dri
        permissions: rwm
{% endif %}
{% endif %}
    environment:
      TZ: {{ base_timezone }}
{% if jellyfin_gpu_vendor == 'nvidia' %}
      NVIDIA_VISIBLE_DEVICES: {{ jellyfin_nvidia_devices }}
      NVIDIA_DRIVER_CAPABILITIES: all
{% endif %}
{% if jellyfin_published_url %}
      JELLYFIN_PublishedServerUrl: {{ jellyfin_published_url }}
{% endif %}
    ports:
      - "8096:8096"        # HTTP
      - "7359:7359/udp"    # client auto-discovery
      - "1900:1900/udp"    # DLNA
    volumes:
      - {{ jellyfin_dir }}/config:/config
      - {{ jellyfin_dir }}/cache:/cache
      - {{ jellyfin_media_path }}:/media:ro
