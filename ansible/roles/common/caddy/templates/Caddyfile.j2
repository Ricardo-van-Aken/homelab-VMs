# {{ ansible_managed }}
{
	admin off
	http_port {{ caddy_http_port }}
{% if caddy_https | bool %}
	https_port {{ caddy_https_port }}
	email {{ caddy_acme_email }}
{% else %}
	auto_https off
{% endif %}
}

# Imported by every site. With HTTPS: prove the name with a temporary DNS
# record at the provider, and give it time to reach all nameservers.
(dns_challenge) {
{% if caddy_https | bool %}
	tls {
		dns {{ caddy_dns_provider }} {env.CADDY_DNS_TOKEN}
		propagation_delay {{ caddy_dns_propagation_delay }}s
	}
{% endif %}
}

# One file per service, written by its role.
import sites/*.caddy
